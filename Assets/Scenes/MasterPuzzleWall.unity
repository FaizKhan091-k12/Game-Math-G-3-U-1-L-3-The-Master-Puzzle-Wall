      m_Calls: []
  m_text: '<b><color=#38BDF8>MASTER PATTERN SOLVER RECAP</color></b>

    <size=90%>-
    <b>Negative Numbers:</b> Below zero use a minus sign and decrease downward.

    -
    <b>Even Numbers:</b> End in 0, 2, 4, 6, 8 and split evenly into two equal parts.

    -
    <b>Square Numbers:</b> Form perfect square arrays (4 x 4 = 16) with identical
    rows & columns.

    - <b>Divisibility:</b> Factors divide evenly with 0 remainder
    (18 / 3 = 6). Any number ending in 0 divides by 10!</size>'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
